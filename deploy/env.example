# Copy this file to .env (next to this deploy/ directory, i.e. the repo
# root) and fill in real values. .env is gitignored — never commit it.
#
# deploy/run.sh sources this automatically for cron runs. Running a
# script BY HAND does not — Python doesn't read .env on its own — so
# load it yourself first:
#
#   set -a; source .env; set +a


# --- Discord (required for any notification to actually send) ----------
# Channel -> Edit Channel -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=
# Your numeric Discord user id, used for the @mention at the front of
# each alert. Enable Developer Mode (Settings -> Advanced), then
# right-click your name -> Copy User ID. Optional: messages still post
# without it, just without pinging you.
DISCORD_USER_ID=


# --- EU multi-market pilot (pilot/eu_multimarket/) ---------------------
# Where deliveries are quoted TO. Every market is pinned to this one
# destination so their dates mean the same thing and can be compared —
# without it Amazon geolocates a different country per marketplace and
# the numbers stop being comparable at all.
DELIVERY_COUNTRY=Sweden
# Used on the domestic market only (amazon.se's location modal has no
# country picker; the other markets' postcode fields are validated
# against their own country and can't express Sweden). No space.
DELIVERY_POSTCODE=37116


# --- Debugging (leave unset for normal runs) ---------------------------
# "false" shows the browser window instead of running headless.
# HEADLESS=false
# "true" logs a full page snapshot for every product, not just the ones
# that come back UNKNOWN. Verbose, but it's what makes a bad run
# diagnosable from the log alone.
# DEBUG=true
